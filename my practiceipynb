    "def prepare_landsat_lst(image):\n",
    "\n",
    "    qa = image.select(\"QA_PIXEL\")\n",
    "\n",
    "    clear = (\n",
    "        qa.bitwiseAnd(1 << 1).eq(0)\n",
    "        .And(\n",
    "            qa.bitwiseAnd(1 << 2).eq(0)\n",
    "        )\n",
    "        .And(\n",
    "            qa.bitwiseAnd(1 << 3).eq(0)\n",
    "        )\n",
    "        .And(\n",
    "            qa.bitwiseAnd(1 << 4).eq(0)\n",
    "        )\n",
    "        .And(\n",
    "            qa.bitwiseAnd(1 << 5).eq(0)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    lst_c = (\n",
    "        image\n",
    "        .select(\"ST_B10\")\n",
    "        .multiply(0.00341802)\n",
    "        .add(149.0)\n",
    "        .subtract(273.15)\n",
    "        .rename(\"LST_C\")\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        lst_c\n",
    "        .updateMask(clear)\n",
    "        .copyProperties(\n",
    "            image,\n",
    "            [\"system:time_start\"]\n",
    "        )\n",
    "    )"
   ]
