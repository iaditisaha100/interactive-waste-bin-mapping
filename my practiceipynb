    "def calculate_ndvi(image):\n",
    "\n",
    "    ndvi = (\n",
    "        image\n",
    "        .normalizedDifference(\n",
    "            [\"B8\", \"B4\"]\n",
    "        )\n",
    "        .rename(\"NDVI\")\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        ndvi\n",
    "        .copyProperties(\n",
    "            image,\n",
    "            [\"system:time_start\"]\n",
    "        )\n",
    "    )"
   ]
